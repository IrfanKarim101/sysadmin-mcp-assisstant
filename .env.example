# Copy to .env. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI-compatible local server (Ollama, LM Studio, vLLM, or LocalAI).
# Ollama's default OpenAI-compatible endpoint is shown below. The key is
# optional for local servers that do not require authentication.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_CONTEXT=16384
LOCAL_LLM_TIMEOUT_SECONDS=300
LOCAL_LLM_DEBUG=false
LOCAL_LLM_API_KEY=

# Optional comma-separated additional browser origins. Private-LAN origins are
# allowed automatically. Use HTTPS and secure cookies outside a trusted LAN.
AGENT_ALLOWED_ORIGINS=
AUTH_COOKIE_SECURE=false

# SSH credentials stay in the backend process only.
SYSADMIN_SSH_PASSWORD_OLAF=
